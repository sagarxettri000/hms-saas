  updatedAt    DateTime?    @updatedAt
}

// ============================================================
// ACCOUNTING
// ============================================================

model Account {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  type        String    // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  parentId    String?
  isActive    Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("accounts")
}

model JournalEntry {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryNumber String
  date        DateTime  @default(now())
  description String?
  referenceType String?
  referenceId String?
  createdBy   String?
  createdAt   DateTime  @default(now())

  lines       JournalLine[]

  @@index([tenantId, date])
  @@map("journal_entries")
  updatedAt    DateTime?    @updatedAt
}

model JournalLine {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntryId String
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Decimal       @default(0) @db.Decimal(14, 2)
  credit         Decimal       @default(0) @db.Decimal(14, 2)
  notes          String?

  @@index([tenantId])
  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
  createdAt    DateTime     @default(now())
}

model CashSession {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingCash Decimal   @default(0) @db.Decimal(14, 2)
  closingCash Decimal?  @db.Decimal(14, 2)
  expectedCash Decimal? @db.Decimal(14, 2)
  difference  Decimal?  @db.Decimal(14, 2)
  status      String    @default("OPEN") // OPEN, CLOSED
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  handovers   CashHandover[]

  @@index([tenantId, userId])
  @@map("cash_sessions")
}

model CashHandover {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSessionId String
  cashSession  CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  fromUserId   String
  toUserId     String
  amount       Decimal     @db.Decimal(14, 2)
  method       PaymentMethod @default(CASH)
  referenceNumber String?
  notes        String?
  handoverAt   DateTime    @default(now())
  confirmedAt  DateTime?
  confirmedBy  String?
  createdAt    DateTime    @default(now())

  @@index([tenantId])
  @@map("cash_handovers")
}

// ============================================================
// HRMS
// ============================================================

model Shift {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  startTime   String
  endTime     String
  workingHours Decimal? @db.Decimal(5, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  rosters     Roster[]

  @@index([tenantId])
  @@map("shifts")
  updatedAt    DateTime?    @updatedAt
}

model Roster {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId     String?
  shift       Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  date        DateTime
  isActive    Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, date])
  @@map("rosters")
}

model Leave {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LeaveType   @default(CASUAL)
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  rejectionReason String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenantId, userId])
  @@map("leaves")
}

// ============================================================
// CRM / TOURISM / CMS
// ============================================================

model Enquiry {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  source      String?       // WEBSITE, PHONE, WALKIN, REFERRAL, SOCIAL_MEDIA, OTHER
  subject     String?
  message     String?
  status      EnquiryStatus @default(NEW)
  assignedTo  String?
  nextFollowUpAt DateTime?
  notes       String?
  convertedToPatientId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, status])
  @@map("enquiries")
}

model MedicalTourismCase {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId   String?
  patient     Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  enquiryId   String?
  country     String?
  language    String?
  passportNumber String?
  treatmentInquiry String?
  estimatedCost Decimal? @db.Decimal(14, 2)
  status      String    @default("NEW")
  visaStatus  String?
  accommodation String?
  transport   String?
  concierge   String?
  carePlan    Json?
  paymentMilestones Json?
  caseTimeline Json?
  assignedTo  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("medical_tourism_cases")
}

model BlogPost {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  excerpt       String?
  content       String
  authorId      String?
  category      String?
  featuredImage String?
  seoTitle      String?
  metaDescription String?
  openGraph     Json?
  status        String    @default("DRAFT") // DRAFT, REVIEW, PUBLISHED, SCHEDULED
  publishedAt   DateTime?
  scheduledAt   DateTime?
  views         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("blog_posts")
}

// ============================================================
// NOTIFICATIONS / AUDIT / AI / WEBHOOKS
// ============================================================

model Notification {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  type      String?
  referenceType String?
  referenceId String?
  status    NotificationStatus  @default(PENDING)
  readAt    DateTime?
  sentAt    DateTime?
  error     String?
  createdAt DateTime            @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("notifications")
}

model AuditLog {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userRole     String?
  entity       String
  entityId     String?
  action       AuditAction
  previousValue Json?
  newValue      Json?
  ipAddress    String?
  deviceId     String?
  userAgent    String?
  metadata     Json?
  timestamp    DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([tenantId, timestamp])
  @@index([tenantId, entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model Webhook {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  secret    String?
  events    Json
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  status       String   @default("PENDING") // PENDING, DELIVERED, FAILED
  attempts     Int      @default(0)
  responseCode Int?
  responseBody String?
  error        String?
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([webhookId])
  @@map("webhook_deliveries")
}

model ApiKey {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  key       String    @unique
  prefix    String
  permissions Json?
  lastUsedAt DateTime?
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@map("api_keys")
}

model UsageMetric {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime @default(now())
  metric    String
  value     Int      @default(0)

  @@index([tenantId, date])
  @@index([metric, date])
  @@map("usage_metrics")
  createdAt    DateTime     @default(now())
}

model DocumentSignature {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId    String?
  patient      Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  documentType String   // Prescription, LabReport, RadiologyReport, DischargeSummary, Consent
  documentId   String
  signedBy     String?
  signer       User?    @relation(fields: [signedBy], references: [id], onDelete: SetNull)
  signerName   String
  signerRole   String?
  signatureData String? // Base64/PNG of handwritten signature (optional)
  signedAt     DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  consentText  String?
  isAmendment  Boolean  @default(false)
  supersedesId String?
  createdAt    DateTime @default(now())

  @@index([tenantId, documentType, documentId])
  @@index([tenantId, signedBy])
  @@map("document_signatures")
}

model AdverseEvent {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId   String?
  patient     Patient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  encounterId String?
  type        String      // MEDICATION, FALL, INFECTION, SURGICAL, DEVICE, LAB, OTHER
  severity    String      @default("MODERATE") // MILD, MODERATE, SEVERE, FATAL
  category    String?
  description String
  occurredAt  DateTime    @default(now())
  reportedBy  String?
  status      String      @default("OPEN") // OPEN, INVESTIGATING, MITIGATED, CLOSED
  rootCause   String?
  actionsTaken String?
  closedAt    DateTime?
  closedBy    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("adverse_events")
}