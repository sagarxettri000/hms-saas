// ============================================================
// NOTIFICATIONS / AUDIT / AI / WEBHOOKS
// ============================================================

model Notification {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  body          String
  channel       NotificationChannel @default(IN_APP)
  type          String?
  referenceType String?
  referenceId   String?
  status        NotificationStatus  @default(PENDING)
  readAt        DateTime?
  sentAt        DateTime?
  error         String?
  createdAt     DateTime            @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("notifications")
  @@index([userId])
}

model AuditLog {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userRole      String?
  entity        String
  entityId      String?
  action        AuditAction
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  deviceId      String?
  userAgent     String?
  metadata      Json?
  timestamp     DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([tenantId, timestamp])
  @@index([tenantId, entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  secret    String?
  events    Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(cuid())
  webhookId    String
  webhook      Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  status       String    @default("PENDING") // PENDING, DELIVERED, FAILED
  attempts     Int       @default(0)
  responseCode Int?
  responseBody String?
  error        String?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([webhookId])
  @@map("webhook_deliveries")
}

model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  key         String    @unique
  prefix      String
  permissions Json?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("api_keys")
}

model UsageMetric {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime @default(now())
  metric    String
  value     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId, date])
  @@index([metric, date])
  @@map("usage_metrics")
}

model DocumentSignature {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId     String?
  patient       Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  documentType  String // Prescription, LabReport, RadiologyReport, DischargeSummary, Consent
  documentId    String
  signedBy      String?
  signer        User?    @relation(fields: [signedBy], references: [id], onDelete: SetNull)
  signerName    String
  signerRole    String?
  signatureData String? // Base64/PNG of handwritten signature (optional)
  signedAt      DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  consentText   String?
  isAmendment   Boolean  @default(false)
  supersedesId  String?
  createdAt     DateTime @default(now())

  @@index([tenantId, documentType, documentId])
  @@index([tenantId, signedBy])
  @@map("document_signatures")
  @@index([patientId])
  @@index([signedBy])
}

model AdverseEvent {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId    String?
  patient      Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  encounterId  String?
  type         String // MEDICATION, FALL, INFECTION, SURGICAL, DEVICE, LAB, OTHER
  severity     String    @default("MODERATE") // MILD, MODERATE, SEVERE, FATAL
  category     String?
  description  String
  affectedCount Int? // number of people involved in the incident
  occurredAt   DateTime  @default(now())
  reportedBy   String?
  status       String    @default("OPEN") // OPEN, INVESTIGATING, MITIGATED, CLOSED
  rootCause    String?
  actionsTaken String?
  closedAt     DateTime?
  closedBy     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("adverse_events")
  @@index([patientId])
}

model AmbulanceVehicle {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  callSign        String
  type            String        @default("BASIC") // BASIC, ADVANCED, ICU
  status          String        @default("AVAILABLE") // AVAILABLE, IN_SERVICE, MAINTENANCE
  driverName      String
  currentLocation String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  calls           AmbulanceCall[]

  @@index([tenantId, status])
  @@map("ambulance_vehicles")
}

model AmbulanceCall {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  callerName   String
  callerPhone  String
  patientName  String
  location     String
  complaint    String?
  priority     String            @default("URGENT") // EMERGENCY, URGENT, NON_URGENT
  status       String            @default("PENDING") // PENDING, DISPATCHED, EN_ROUTE, ARRIVED, COMPLETED, CANCELLED
  dispatchedAt DateTime?
  vehicleId    String?
  vehicle      AmbulanceVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  history      Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, vehicleId])
