# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hms_saas
POSTGRES_DB=hms_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Server
JWT_ACCESS_SECRET=generate-a-strong-random-secret-here
JWT_REFRESH_SECRET=generate-another-strong-random-secret-here
SERVER_PORT=4000
NODE_ENV=development
ENABLE_RLS=false
CORS_ORIGIN=http://localhost:3000
# Base URL of the web app, used to build password-reset links
APP_URL=http://localhost:3000

# Email (SMTP) — used for password reset, notifications, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HMS SaaS <no-reply@hms.local>

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_PORT=3000