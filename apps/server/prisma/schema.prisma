enum PreauthStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

model InsurancePreauthorization {
  id             String        @id @default(cuid())
  tenantId       String
  patientId      String?
  patientName    String?
  providerName   String?
  policyNumber   String?
  treatment      String
  estimatedCost  Decimal       @db.Decimal(14, 2)
  approvedAmount Decimal?      @db.Decimal(14, 2)
  status         PreauthStatus @default(PENDING)
  requestedDate  DateTime      @default(now())
  decisionDate   DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      String?
  updatedBy      String?

  @@index([tenantId, status])
  @@map("insurance_preauthorizations")
}

model ControlledSubstanceLog {
  id         String       @id @default(cuid())
  tenantId   String
  drug       String
  quantity   Decimal      @db.Decimal(10, 2)
  patient    String?
  notes      String?
  loggedAt   DateTime     @default(now())
  loggedBy   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([tenantId, drug])
  @@map("controlled_substance_logs")
}

model StockTransfer {
  id              String      @id @default(cuid())
  tenantId        String
  fromStoreId     String?
  toStoreId       String?
  inventoryItemId String?
  fromStore       String?
  toStore         String?
  itemName        String?
  quantity        Decimal     @db.Decimal(12, 3)
  status          String      @default("COMPLETED")
  transferredAt   DateTime    @default(now())
  createdBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId, transferredAt])
  @@map("stock_transfers")
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffName String?
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  clockIn   DateTime
  clockOut  DateTime?
  hours     Decimal?         @db.Decimal(5, 2)
  rosterId  String?
  roster    Roster?          @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  createdBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, userId, date])
  @@index([tenantId, date])
  @@index([userId, date])
  @@map("attendance_records")
