model StaffTraining {
  id              String    @id @default(cuid())
  tenantId        String
  staffName       String?
  program         String
  enrolledAt      DateTime  @default(now())
  completedAt     DateTime?
  certificateDate DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, program])
  @@map("staff_trainings")
}

model QualityChecklist {
  id         String    @id @default(cuid())
  tenantId   String
  category   String
  item       String
  checked    Boolean   @default(false)
  checkedBy  String?
  checkedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, category, item])
  @@index([tenantId, category])
  @@map("quality_checklists")
}

model ShiftHandover {
  id        String    @id @default(cuid())
  tenantId  String
  wardId    String?
  wardName  String?
  shiftDate DateTime
  notes     String?
  savedBy   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, shiftDate])
  @@map("shift_handovers")
}

// ============================================================
// SERVICE MASTER + DISCHARGE BILLING
// ============================================================

model ServiceCategory {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  code         String
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services BillingService[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("service_categories")
}

model ChargeTransaction {
  id                   String        @id @default(cuid())
  tenantId             String
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId            String
  patient              Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  admissionId          String?
  admission            Admission?    @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  encounterId          String?
  encounter            Encounter?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  serviceId            String?
  service              BillingService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  sourceModule         String        // IPD, OPD, EMERGENCY, LAB, RADIOLOGY, OT, PHARMACY, INVENTORY, BLOOD_BANK, DIET, NURSING, AMBULANCE, ADMIN, MANUAL
  sourceTransactionId  String?
  serviceDate          DateTime      @default(now())
  quantity             Decimal       @default(1) @db.Decimal(10, 2)
  unitRate             Decimal       @default(0) @db.Decimal(14, 2)
  grossAmount          Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount       Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount            Decimal       @default(0) @db.Decimal(14, 2)
  netAmount            Decimal       @default(0) @db.Decimal(14, 2)
  insuranceAmount      Decimal       @default(0) @db.Decimal(14, 2)
  patientAmount        Decimal       @default(0) @db.Decimal(14, 2)
  status               ChargeStatus  @default(PENDING)
  billingStatus        String        @default("UNBILLED") // UNBILLED, BILLED, CANCELLED
  dischargeBillId      String?
  dischargeBill        DischargeBill? @relation(fields: [dischargeBillId], references: [id], onDelete: SetNull)
  createdBy            String?
  createdAt            DateTime      @default(now())

  dischargeBillDetails DischargeBillDetail[]

  @@index([tenantId, patientId])
  @@index([tenantId, admissionId])
  @@index([tenantId, sourceModule, sourceTransactionId])
  @@index([tenantId, billingStatus])
  @@index([tenantId, serviceDate])
  @@map("charge_transactions")
}

model DischargeBill {
  id                   String                @id @default(cuid())
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billNumber           String
  patientId            String
  patient              Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  admissionId          String
  admission            Admission             @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  encounterId          String?
  encounter            Encounter?            @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  invoiceId            String?
  invoice              Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  billDate             DateTime              @default(now())
  admissionDate        DateTime?
  dischargeDate        DateTime?
  subtotal             Decimal               @default(0) @db.Decimal(14, 2)
  discount             Decimal               @default(0) @db.Decimal(14, 2)
  discountReason       String?
  discountApprovedBy   String?
  tax                  Decimal               @default(0) @db.Decimal(14, 2)
  insuranceAmount      Decimal               @default(0) @db.Decimal(14, 2)
  corporateAmount      Decimal               @default(0) @db.Decimal(14, 2)
  advanceAdjustment    Decimal               @default(0) @db.Decimal(14, 2)
  previousDue          Decimal               @default(0) @db.Decimal(14, 2)
  refundAmount         Decimal               @default(0) @db.Decimal(14, 2)
  roundingAdjustment   Decimal               @default(0) @db.Decimal(2, 2)
  netAmount            Decimal               @default(0) @db.Decimal(14, 2)
  paidAmount           Decimal               @default(0) @db.Decimal(14, 2)
  dueAmount            Decimal               @default(0) @db.Decimal(14, 2)
  status               DischargeBillStatus   @default(DRAFT)
  paymentStatus        DischargePaymentStatus @default(UNPAID)
  dischargeStatus      String                @default("BILLING_PENDING") // BILLING_PENDING, CLEARED
  remarks              String?
  createdBy            String?
  finalizedBy          String?
  finalizedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  details              DischargeBillDetail[]
  chargeTransactions   ChargeTransaction[]

  @@unique([tenantId, billNumber])
  @@index([tenantId, patientId])
  @@index([tenantId, admissionId])
  @@index([tenantId, status])
  @@index([tenantId, billDate])
  @@map("discharge_bills")
}

model DischargeBillDetail {
  id                   String            @id @default(cuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dischargeBillId      String
  dischargeBill        DischargeBill     @relation(fields: [dischargeBillId], references: [id], onDelete: Cascade)
  chargeTransactionId  String?
  chargeTransaction    ChargeTransaction? @relation(fields: [chargeTransactionId], references: [id], onDelete: SetNull)
  serviceId            String?
  service              BillingService?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceCode          String?
  serviceName          String
  categoryId           String?
  sourceModule         String?
  sourceTransactionId  String?
  serviceDate          DateTime?
  description          String?
  quantity             Decimal           @default(1) @db.Decimal(10, 2)
  unit                 String?
  unitRate             Decimal           @default(0) @db.Decimal(14, 2)
  grossAmount          Decimal           @default(0) @db.Decimal(14, 2)
  discount             Decimal           @default(0) @db.Decimal(14, 2)
  tax                  Decimal           @default(0) @db.Decimal(14, 2)
  insuranceAmount      Decimal           @default(0) @db.Decimal(14, 2)
  patientAmount        Decimal           @default(0) @db.Decimal(14, 2)
  netAmount            Decimal           @default(0) @db.Decimal(14, 2)
  manuallyAdded       Boolean           @default(false)
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime?         @updatedAt

  @@index([tenantId, dischargeBillId])
  @@index([tenantId, serviceId])
  @@map("discharge_bill_details")
}
