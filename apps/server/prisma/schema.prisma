// ============================================================
// PLATFORM / TENANT CORE
// ============================================================

model Tenant {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  logoUrl     String?
  description String?
  status      TenantStatus @default(TRIAL)
  requireTwoFactor  Boolean @default(false)
  timezone    String       @default("Asia/Kathmandu")
  currency    String       @default("NPR")
  language    String       @default("en")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdBy   String?

  addressLine1       String?
  addressLine2       String?
  city               String?
  district           String?
  province           String?
  country            String? @default("Nepal")
  postalCode         String?
  phone              String?
  email              String?
  website            String?
  panNumber          String?
  vatNumber          String?
  registrationNumber String?

  branches                Branch[]
  departments             Department[]
  users                   User[]
  subscriptions           Subscription[]
  featureFlags            TenantFeatureFlag[]
  settings                TenantSetting[]
  wards                   Ward[]
  rooms                   Room[]
  beds                    Bed[]
  bedMaintenances         BedMaintenance[]
  patients                Patient[]
  appointments            Appointment[]
  encounters              Encounter[]
  followUps               FollowUp[]
  admissions              Admission[]
  invoices                Invoice[]
  payments                Payment[]
  refunds                 Refund[]
  deposits                Deposit[]
  invoiceItems            InvoiceItem[]
  labOrderItems           LabOrderItem[]
  prescriptionItems       PrescriptionItem[]
  journalLines            JournalLine[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  integrationSettings     IntegrationSetting[]
  labOrders               LabOrder[]
  labTestPanels           LabTestPanel[]
  radiologyOrders         RadiologyOrder[]
  radiologyReportRevisions RadiologyReportRevision[]
  radiologyPeerReviews     RadiologyPeerReview[]
  otCases                 OTCase[]
  emergencyCases          EmergencyCase[]
  bloodDonors             BloodDonor[]
  medicines               Medicine[]
  inventoryItems          InventoryItem[]
  stores                  Store[]
  suppliers               Supplier[]
  purchaseRequests        PurchaseRequest[]
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  creditAccounts          CreditAccount[]
  insuranceProviders      InsuranceProvider[]
  insurancePolicies       InsurancePolicy[]
  insuranceClaims         InsuranceClaim[]
  doctorShareRules        DoctorShareRule[]
  doctorShareTransactions DoctorShareTransaction[]
  memberships             Membership[]
  membershipPackages      MembershipPackage[]
  accounts                Account[]
  journalEntries          JournalEntry[]
  cashSessions            CashSession[]
  cashHandovers           CashHandover[]
  billingServices         BillingService[]
  billingSchemes          BillingScheme[]
  financialTransactions   FinancialTransaction[]
  billingSettings         BillingSetting[]
  dailyClosings           DailyClosing[]
  depositTransactions     DepositTransaction[]
  shifts                  Shift[]
  rosters                 Roster[]
  leaves                  Leave[]
  enquiries               Enquiry[]
  medicalTourismCases     MedicalTourismCase[]
  blogPosts               BlogPost[]
  webhooks                Webhook[]
  apiKeys                 ApiKey[]
  adverseEvents           AdverseEvent[]
  documentSignatures      DocumentSignature[]
  ambulanceVehicles       AmbulanceVehicle[]
  ambulanceCalls          AmbulanceCall[]
  equipmentItems          EquipmentItem[]
  equipmentLogs           EquipmentLog[]
  serviceCategories       ServiceCategory[]
  chargeTransactions      ChargeTransaction[]
  dischargeBills          DischargeBill[]
  dischargeBillDetails    DischargeBillDetail[]
  dicomStudies            DicomStudy[]
  dicomNodes              DicomNode[]
  attendanceRecords       AttendanceRecord[]

  @@index([status])
  @@index([createdAt])
  @@map("tenants")
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  address   String?
  city      String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Department {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name        String
  code        String
  description String?
  isActive    Boolean      @default(true)
  parentId    String?
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users         User[]
  doctors       DoctorProfile[]
  wards         Ward[]
  appointments  Appointment[]
  encounters    Encounter[]
  staffProfiles StaffProfile[]
  invoiceItems  InvoiceItem[]
  billingServices BillingService[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
  @@index([branchId])
  @@index([parentId])
}

model Room {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wardId     String
  ward       Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  name       String
  roomNumber String?
  roomType   RoomType @default(OTHER)
  capacity   Int      @default(1)
  ratePerDay Decimal  @default(0) @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  beds Bed[]

  @@index([tenantId, wardId])
  @@map("rooms")
  @@index([wardId])
}

model Ward {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name         String
  code         String?
  location     String?
  floor        Int?
  capacity     Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  rooms        Room[]
  beds         Bed[]
  maintenances BedMaintenance[]

  @@index([tenantId, departmentId])
  @@map("wards")
  @@index([departmentId])
}

model Bed {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wardId     String?
  ward       Ward?     @relation(fields: [wardId], references: [id], onDelete: SetNull)
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bedNumber  String
  bedType    BedType   @default(GENERAL)
  status     BedStatus @default(AVAILABLE)
  ratePerDay Decimal   @default(0) @db.Decimal(10, 2)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  allocations  BedAllocation[]
  movements    BedMovement[]
  maintenances BedMaintenance[]

  @@index([tenantId, wardId, roomId])
  @@index([status])
  @@map("beds")
  @@index([roomId])
}

model BedAllocation {
  id          String    @id @default(cuid())
  tenantId    String
  bedId       String
  bed         Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  allocatedAt DateTime  @default(now())
  releasedAt  DateTime?
  status      BedStatus @default(OCCUPIED)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  @@index([tenantId, bedId])
  @@index([tenantId, admissionId])
  @@map("bed_allocations")
  @@index([admissionId])
  @@index([bedId])
}

model BedMovement {
  id          String    @id @default(cuid())
  tenantId    String
  bedId       String
  bed         Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  fromRoomId  String?
  toRoomId    String?
  fromBedId   String?
  toBedId     String?
  reason      String?
  movedBy     String?
  movedAt     DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([tenantId, admissionId])
  @@map("bed_movements")
  @@index([admissionId])
  @@index([bedId])
}

model BedMaintenance {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wardId      String?
  ward        Ward?     @relation(fields: [wardId], references: [id], onDelete: SetNull)
  bedId       String?
  bed         Bed?      @relation(fields: [bedId], references: [id], onDelete: SetNull)
  type        String
  description String?
  scheduledAt DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("SCHEDULED")
  assignedTo  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, wardId])
  @@index([tenantId, bedId])
  @@map("bed_maintenances")
  @@index([bedId])
  @@index([wardId])
}

// ============================================================
// SUBSCRIPTION / PLANS / FEATURE FLAGS
// ============================================================

model Plan {
  id           String           @id @default(cuid())
  name         SubscriptionPlan @unique
  description  String?
  price        Decimal          @default(0) @db.Decimal(10, 2)
  billingCycle BillingCycle     @default(MONTHLY)
  maxUsers     Int              @default(10)
  maxPatients  Int              @default(1000)
  maxStorageMB Int              @default(1024)
  features     Json             @default("{}")
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(TRIAL)
  startDate    DateTime
  endDate      DateTime
  trialEndDate DateTime?
  price        Decimal            @default(0) @db.Decimal(10, 2)
  billingCycle BillingCycle       @default(MONTHLY)
  autoRenew    Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  payments SubscriptionPayment[]

  @@index([tenantId, status])
  @@map("subscriptions")
  @@index([planId])
}

model SubscriptionPayment {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(10, 2)
  paymentDate    DateTime      @default(now())
  paymentMethod  String?
  transactionId  String?
  status         PaymentStatus @default(PENDING)
  invoiceId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime?     @updatedAt

  @@index([subscriptionId])
  @@map("subscription_payments")
}

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  defaultEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenantFlags TenantFeatureFlag[]

  @@map("feature_flags")
}

model TenantFeatureFlag {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flagId    String
  flag      FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  enabled   Boolean     @default(false)
  updatedBy String?
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())

  @@unique([tenantId, flagId])
  @@index([tenantId])
  @@map("tenant_feature_flags")
  @@index([flagId])
}

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_settings")
}

model IntegrationSetting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider  String
  config    Json
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("integration_settings")
}

// ============================================================
// USERS / ROLES / PERMISSIONS
// ============================================================

model User {
  id                 String      @id @default(cuid())
  tenantId           String?
  tenant             Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email              String      @unique
  passwordHash       String
  firstName          String
  middleName         String?
  lastName           String
  phone              String?
  avatarUrl          String?
  role               UserRole    @default(RECEPTIONIST)
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status             UserStatus  @default(PENDING)
  isActive           Boolean     @default(true)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  mustChangePassword Boolean     @default(false)
  failedLoginCount   Int         @default(0)
  lockedUntil        DateTime?
  twoFactorEnabled   Boolean     @default(false)
  twoFactorSecret    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  doctorProfile       DoctorProfile?
  staffProfile        StaffProfile?
  sessions            Session[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  appointments        Appointment[]        @relation("DoctorAppointments")
  createdPatients     Patient[]            @relation("CreatedPatients")
  updatedPatients     Patient[]            @relation("UpdatedPatients")
  passwordResetTokens PasswordResetToken[]
  cashSessions        CashSession[]
  rosters             Roster[]
  leaves              Leave[]
  attendanceRecords   AttendanceRecord[]
  documentSignatures  DocumentSignature[]

  @@index([tenantId])
  @@index([role])
  @@index([status])
  @@map("users")
  @@index([departmentId])
}

model Role {
  id          String   @id @default(cuid())
  name        UserRole @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        PermissionAction @unique
  description String?
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]
  updatedAt       DateTime?        @updatedAt

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@index([permissionId])
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId       String?
  token          String    @unique
  refreshToken   String?   @unique
  refreshTokenHash   String  @unique
  userAgent      String?
  ipAddress      String?
  deviceId       String?
  isActive       Boolean   @default(true)
  expiresAt      DateTime
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  @@index([userId])
  @@index([tenantId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
  @@index([userId])
}

model DoctorProfile {
  id                 String      @id @default(cuid())
  tenantId           String
  userId             String      @unique
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  gender             String?
  specialization     String?
  qualification      String?
  licenseNumber      String?
  registrationNumber String?
  consultationFee    Decimal     @default(0) @db.Decimal(10, 2)
  experienceYears    Int?
  bio                String?
  education          Json?
  certificates       Json?
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  schedules     DoctorSchedule[]
  appointments  Appointment[]
  consultations Encounter[]
  shareRules    DoctorShareRule[]
  prescriptions Prescription[]
  assignedFollowUps FollowUp[] @relation("AssignedFollowUps")
  followUpDoctors   FollowUpDoctor[]
  otCasesAsSurgeon    OTCase[] @relation("OTCSurgeon")
  otCasesAsAssistant  OTCase[] @relation("OTCAssistant")
  otCasesAsAnesthetist OTCase[] @relation("OTCAnesthetist")

  @@index([tenantId])
  @@index([departmentId])
  @@map("doctor_profiles")
}

model DoctorSchedule {
  id           String        @id @default(cuid())
  tenantId     String
  doctorId     String
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 0=Sunday ... 6=Saturday
  startTime    String
  endTime      String
  slotDuration Int           @default(15) // minutes
  breakStart   String?
  breakEnd     String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  slots AvailabilitySlot[]

  @@index([tenantId, doctorId])
  @@map("doctor_schedules")
  @@index([doctorId])
}

model AvailabilitySlot {
  id            String         @id @default(cuid())
  tenantId      String
  scheduleId    String
  schedule      DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  doctorId      String
  date          DateTime
  startTime     String
  endTime       String
  isBooked      Boolean        @default(false)
  isBlocked     Boolean        @default(false)
  appointmentId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId, doctorId, date])
  @@map("availability_slots")
  @@index([scheduleId])
}

model StaffProfile {
  id               String      @id @default(cuid())
  tenantId         String
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String?
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      String?
  joiningDate      DateTime?
  employmentStatus String      @default("ACTIVE")
  qualification    String?
  emergencyContact String?
  bloodGroup       BloodGroup?
  shift            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([tenantId])
  @@map("staff_profiles")
  @@index([departmentId])
}

// ============================================================
// PATIENT
// ============================================================

model Patient {
  id             String  @id @default(cuid())
  tenantId       String
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mrn            String // Medical Record Number
  uid            String? @unique
  hospitalNumber String?
  barcode        String? @unique
  qrCode         String? @unique

  firstName   String
  middleName  String?
  lastName    String
  dateOfBirth DateTime?
  age         Int?
  gender      Gender?
  bloodGroup  BloodGroup?
  nationality String      @default("Nepali")
  religion    String?

  phone  String?
  mobile String?
  email  String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  province     String?
  country      String  @default("Nepal")
  postalCode   String?

  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  emergencyContactMobile       String?

  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  guardianEmail        String?
  guardianIdType       String?
  guardianIdNumber     String?

  occupation     String?
  education      String?
  maritalStatus  MaritalStatus?
  nationalId     String?
  passportNumber String?

  patientType PatientType   @default(GENERAL)
  status      PatientStatus @default(INACTIVE)

  isForeign Boolean @default(false)
  isStaff   Boolean @default(false)
  isMember  Boolean @default(false)

  consentGiven Boolean   @default(false)
  consentDate  DateTime?
  consentNotes String?

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdByUser User? @relation("CreatedPatients", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("UpdatedPatients", fields: [updatedBy], references: [id], onDelete: SetNull)

  allergies           PatientAllergy[]
  conditions          PatientCondition[]
  documents           PatientDocument[]
  appointments        Appointment[]
  encounters          Encounter[]
  admissions          Admission[]
  insurancePolicies   InsurancePolicy[]
  invoices            Invoice[]
  payments            Payment[]
  refunds             Refund[]
  deposits            Deposit[]
  prescriptions       Prescription[]
  labOrders           LabOrder[]
  radiologyOrders     RadiologyOrder[]
  dicomStudies        DicomStudy[]
  memberships         Membership[]
  emergencyCases      EmergencyCase[]
  vitals              Vital[]
  otCases             OTCase[]
  creditAccounts      CreditAccount[]
  insuranceClaims     InsuranceClaim[]
  medicalTourismCases MedicalTourismCase[]
  adverseEvents       AdverseEvent[]
  documentSignatures  DocumentSignature[]
  followUps           FollowUp[]
  chargeTransactions  ChargeTransaction[]
  dischargeBills      DischargeBill[]
  financialTransactions FinancialTransaction[]

  @@index([tenantId, mrn])
  @@index([tenantId, mobile])
  @@index([tenantId, firstName, lastName])
  @@index([status])
  @@map("patients")
  @@index([createdBy])
  @@index([updatedBy])
}

model PatientAllergy {
  id        String   @id @default(cuid())
  tenantId  String
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen  String
  reaction  String?
  severity  String?
  onset     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, patientId])
  @@map("patient_allergies")
  @@index([patientId])
}

model PatientCondition {
  id            String    @id @default(cuid())
  tenantId      String
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name          String
  icd10Code     String?
  diagnosedDate DateTime?
  status        String?   @default("ACTIVE")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, patientId])
  @@map("patient_conditions")
  @@index([patientId])
}

model PatientDocument {
  id           String   @id @default(cuid())
  tenantId     String
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title        String
  documentType String
  fileName     String
  filePath     String
  mimeType     String
  fileSize     Int
  uploadedBy   String?
  uploadedAt   DateTime @default(now())
  isPrivate    Boolean  @default(true)
  description  String?
  createdAt    DateTime @default(now())

  @@index([tenantId, patientId])
  @@map("patient_documents")
  @@index([patientId])
}

// ============================================================
// APPOINTMENTS
// ============================================================

model Appointment {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId           String
  doctor             DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorUserId       String?
  doctorUser         User?             @relation("DoctorAppointments", fields: [doctorUserId], references: [id], onDelete: SetNull)
  departmentId       String?
  department         Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  scheduleId         String?
  slotId             String?
  appointmentDate    DateTime
  startTime          String
  endTime            String
  type               AppointmentType   @default(OPD)
  status             AppointmentStatus @default(REQUESTED)
  source             AppointmentSource @default(WALKIN)
  reason             String?
  notes              String?
  tokenNumber        String?
  isWalkIn           Boolean           @default(false)
  checkInAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  encounter Encounter?

  @@index([tenantId, patientId])
  @@index([tenantId, doctorId])
  @@index([tenantId, appointmentDate])
  @@index([status])
  @@map("appointments")
  @@index([departmentId])
  @@index([doctorId])
  @@index([doctorUserId])
  @@index([patientId])
}

// ============================================================
// ENCOUNTERS / CLINICAL
// ============================================================

model Encounter {
  id                    String          @id @default(cuid())
  tenantId              String
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId             String
  patient               Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointmentId         String?         @unique
  appointment           Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctorId              String?
  doctor                DoctorProfile?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  doctorUserId          String?
  departmentId          String?
  department            Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  type                  EncounterType   @default(OPD)
  status                EncounterStatus @default(ACTIVE)
  symptoms              String?
  history               String?
  examination           String?
  diagnosis             String?
  icd10Code             String?
  clinicalNotes         String?
  treatment             String?
  advice                String?
  followUpDate          DateTime?
  followUpNotes         String?
  chiefComplaint        String?
  consultationStartedAt DateTime?
  consultationEndedAt   DateTime?
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  vitals          Vital[]
  diagnoses       Diagnosis[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  procedures      Procedure[]
  nursingNotes    NursingNote[]
  admission       Admission?
  followUps       FollowUp[]
  dischargeBills  DischargeBill[]
  chargeTransactions ChargeTransaction[]

  @@index([tenantId, patientId])
  @@index([tenantId, doctorId])
  @@index([status])
  @@map("encounters")
  @@index([departmentId])
  @@index([doctorId])
  @@index([patientId])
}

model FollowUp {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounterId     String?
  encounter       Encounter?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  status          FollowUpStatus @default(PENDING)
  notes           String?
  assignedDoctorId String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assignedDoctor DoctorProfile? @relation("AssignedFollowUps", fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  doctors        FollowUpDoctor[]

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([assignedDoctorId])
  @@index([encounterId])
  @@map("follow_ups")
}

model FollowUpDoctor {
  id           String        @id @default(cuid())
  tenantId     String
  followUpId   String
  followUp     FollowUp      @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  isPrimary    Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([followUpId])
  @@index([doctorId])
  @@map("follow_up_doctors")
}

model Vital {
  id                     String     @id @default(cuid())
  tenantId               String
  encounterId            String?
  encounter              Encounter? @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId              String
  patient                Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  admissionId            String?
  temperature            Decimal?   @db.Decimal(5, 2)
  pulse                  Int?
  respiratoryRate        Int?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  oxygenSaturation       Decimal?   @db.Decimal(5, 2)
  height                 Decimal?   @db.Decimal(6, 2)
  weight                 Decimal?   @db.Decimal(6, 2)
  bmi                    Decimal?   @db.Decimal(5, 2)
  headCircumference      Decimal?   @db.Decimal(6, 2)
  painScore              Int?
  bloodGlucose           Decimal?   @db.Decimal(6, 2)
  recordedBy             String?
  notes                  String?
  recordedAt             DateTime   @default(now())
  createdAt              DateTime   @default(now())
  updatedAt              DateTime?  @updatedAt

  @@index([tenantId, patientId])
  @@index([tenantId, encounterId])
  @@map("vitals")
  @@index([encounterId])
  @@index([patientId])
}

model Diagnosis {
  id          String     @id @default(cuid())
  tenantId    String
  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId   String
  icd10Code   String?
  name        String
  type        String? // PRIMARY, SECONDARY, etc.
  notes       String?
  isPrimary   Boolean    @default(false)
  confirmedBy String?
  confirmedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime?  @updatedAt

  @@index([tenantId, patientId])
  @@index([encounterId])
  @@map("diagnoses")
}

model Prescription {
  id          String         @id @default(cuid())
  tenantId    String
  patientId   String
  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounterId String?
  encounter   Encounter?     @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  doctorId    String?
  doctor      DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  status      String         @default("DRAFT") // DRAFT, APPROVED, DISPENSED
  doctorNote  String?
  advice      String?
  followUp    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  updatedBy   String?
  signedBy    String?
  signedAt    DateTime?

  items PrescriptionItem[]

  @@index([tenantId, patientId])
  @@map("prescriptions")
  @@index([doctorId])
  @@index([encounterId])
  @@index([patientId])
}

model PrescriptionItem {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptionId  String
  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName    String
  genericName     String?
  brandName       String?
  medicineId      String?
  medicine        Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  dosage          String?
  frequency       String?
  route           String?
  duration        String?
  quantity        Int?
  instructions    String?
  strength        String?
  unit            String?
  daysSupply      Int?
  isSubstitutable Boolean      @default(true)
  status          String       @default("PRESCRIBED")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime?    @updatedAt

  @@index([tenantId])
  @@index([prescriptionId])
  @@map("prescription_items")
  @@index([medicineId])
}

model Procedure {
  id          String     @id @default(cuid())
  tenantId    String
  patientId   String
  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  name        String
  code        String?
  category    String?
  performedBy String?
  performedAt DateTime?
  findings    String?
  notes       String?
  status      String     @default("SCHEDULED")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, patientId])
  @@map("procedures")
  @@index([encounterId])
}

// ============================================================
// ADMISSION / IPD / NURSING
// ============================================================

model Admission {
  id                   String          @id @default(cuid())
  tenantId             String
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId            String
  patient              Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounterId          String?         @unique
  encounter            Encounter?      @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  admissionNumber      String
  admissionDate        DateTime        @default(now())
  admissionType        String          @default("GENERAL") // GENERAL, EMERGENCY, PLANNED, TRANSFER
  referringDoctor      String?
  admittingDoctorId    String?
  departmentId         String?
  status               AdmissionStatus @default(ADMITTED)
  provisionalDiagnosis String?
  finalDiagnosis       String?
  primaryDiagnosis     String?
  dischargeDate        DateTime?
  dischargeType        String?
  dischargeSummary     String?
  dischargeRequestedAt DateTime?
  dischargeClearedAt   DateTime?
  dischargeApprovedBy  String?
  isDischarged         Boolean         @default(false)
  notes                String?
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  bedAllocations            BedAllocation[]
  bedMovements              BedMovement[]
  insuranceCoverage         Json?
  deposits                  Deposit[]
  invoices                  Invoice[]
  medicationAdministrations MedicationAdministration[]
  labOrders                 LabOrder[]
  radiologyOrders           RadiologyOrder[]
  chargeTransactions        ChargeTransaction[]
  dischargeBills            DischargeBill[]
  emergencyCase             EmergencyCase?

  @@index([tenantId, patientId])
  @@index([status])
  @@index([admissionDate])
  @@map("admissions")
  @@index([patientId])
}

model NursingNote {
  id          String     @id @default(cuid())
  tenantId    String
  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId   String
  admissionId String?
  nurseId     String?
  note        String
  assessment  String?
  plan        String?
  createdBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, patientId])
  @@map("nursing_notes")
  @@index([encounterId])
}

model MedicationAdministration {
  id                 String     @id @default(cuid())
  tenantId           String
  patientId          String
  admissionId        String?
  admission          Admission? @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  prescriptionItemId String?
  medicineName       String
  medicineId         String?
  dose               String
  route              String?
  scheduledTime      DateTime
  givenTime          DateTime?
  givenBy            String?
  status             String     @default("SCHEDULED") // SCHEDULED, DUE, GIVEN, MISSED, HELD, REFUSED
  remarks            String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([tenantId, patientId])
  @@map("medication_administrations")
  @@index([admissionId])
}

// ============================================================
// LABORATORY
// ============================================================

model LabTest {
  id             String        @id @default(cuid())
  tenantId       String
  name           String
  code           String?
  category       String?
  specimenType   String?
  container      String?
  quantity       String?
  referenceRange String?
  unit           String?
  price          Decimal       @default(0) @db.Decimal(10, 2)
  turnaroundTime Int?
  discipline     String? // MICROBIOLOGY, HISTOPATHOLOGY, HEMATOLOGY, BIOCHEMISTRY, IMMUNOLOGY
  status         LabTestStatus @default(ACTIVE)
  isActive       Boolean       @default(true)
  method         String?       // assay methodology (e.g. "Automated hematology analyzer", "Westergren")
  precision      Int?          // decimal places used when rendering numeric results
  resultType     String        @default("NUMERIC") // NUMERIC | TEXT
  referenceRanges Json?        // [{label?, low?, high?, sex? (MALE|FEMALE|OTHER), unit?, note?}]
  sortOrder      Int?          // display ordering within a panel/category
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  labOrderItems LabOrderItem[]
  panelItems    LabTestPanelItem[]

  @@index([tenantId])
  @@map("lab_tests")
}

model LabOrder {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounterId  String?
  encounter    Encounter?     @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  admissionId  String?
  admission    Admission?     @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  doctorId     String?
  orderNumber  String
  status       LabOrderStatus @default(ORDERED)
  isStat       Boolean        @default(false)
  isEmergency  Boolean        @default(false)
  orderedAt    DateTime       @default(now())
  collectedAt  DateTime?
  receivedAt   DateTime?
  processedAt  DateTime?
  reportedAt   DateTime?
  verifiedAt   DateTime?
  approvedAt   DateTime?
  verifiedBy   String?
  approvedBy   String?
  clinicalNote String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items   LabOrderItem[]
  samples LabSample[]

  @@index([tenantId, patientId])
  @@index([status])
  @@map("lab_orders")
  @@index([encounterId])
  @@index([patientId])
}

model LabOrderItem {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  labOrderId     String
  labOrder       LabOrder  @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTestId      String?
  labTest        LabTest?  @relation(fields: [labTestId], references: [id], onDelete: SetNull)
  testName       String
  price          Decimal   @default(0) @db.Decimal(10, 2)
  status         String    @default("ORDERED")
  result         String?
  resultValue    Decimal?  @db.Decimal(12, 4)
  unit           String?
  referenceRange String?
  isAbnormal     Boolean?
  isCritical     Boolean?
  notes          String?
  method         String?
  precision      Int?
  resultType     String?
  refLow         Decimal?  @db.Decimal(12, 4)
  refHigh        Decimal?  @db.Decimal(12, 4)
  rangeLabel     String?
  resultEnteredBy  String?
  resultEnteredAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

