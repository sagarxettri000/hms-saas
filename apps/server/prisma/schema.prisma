// ============================================================
// BILLING / PAYMENTS / DEPOSITS / REFUNDS / CREDIT
// ============================================================

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admissionId    String?
  admission      Admission?    @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  encounterId    String?
  type           InvoiceType   @default(OPD)
  status         InvoiceStatus @default(PENDING)
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount Decimal       @default(0) @db.Decimal(14, 2)
  discountPercent Decimal?     @db.Decimal(5, 2)
  discountReason String?
  discountApprovedBy String?
  discountApprovedAt DateTime?
  discountRequestedBy String?
  discountRequestedAt DateTime?
  discountRejectedBy String?
  discountRejectedAt DateTime?
  discountRejectReason String?
  discountStatus DiscountStatus?
  taxAmount      Decimal       @default(0) @db.Decimal(14, 2)
  taxPercent     Decimal?      @db.Decimal(5, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(14, 2)
  dueAmount      Decimal       @default(0) @db.Decimal(14, 2)
  isCredit       Boolean       @default(false)
  schemeId       String?
  scheme         BillingScheme? @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  printCount     Int           @default(0)
  issuedDate     DateTime      @default(now())
  dueDate        DateTime?
  notes          String?
  createdBy      String?
  settledBy      String?
  settledAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          InvoiceItem[]
  payments       Payment[]
  refunds        Refund[]
  deposits       Deposit[]

  @@index([tenantId, patientId])
  @@index([tenantId, invoiceNumber])
  @@index([status])
  @@map("invoices")
}

model BillingScheme {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  code            String?
  description     String?
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  rules           Json?
  isActive        Boolean   @default(true)
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoices        Invoice[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("billing_schemes")
}

model InvoiceItem {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceName    String
  serviceCode    String?
  description    String?
  quantity       Decimal   @default(1) @db.Decimal(10, 2)
  rate           Decimal   @default(0) @db.Decimal(10, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount Decimal   @default(0) @db.Decimal(10, 2)
  taxPercent     Decimal?  @db.Decimal(5, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(10, 2)
  lineTotal      Decimal   @default(0) @db.Decimal(14, 2)
  doctorId       String?
  departmentId   String?
  serviceId      String?
  referenceType  String?
  referenceId    String?
  createdAt      DateTime  @default(now())

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_items")
  updatedAt    DateTime?    @updatedAt
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentNumber String
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod @default(CASH)
  status      PaymentStatus @default(PENDING)
  transactionId String?
  referenceNumber String?
  idempotencyKey String?
  paidAt      DateTime      @default(now())
  receivedBy  String?
  notes       String?
  paymentType PaymentType   @default(INVOICE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  refunds     Refund[]

  @@index([tenantId, patientId])
  @@index([tenantId, invoiceId])
  @@unique([tenantId, idempotencyKey])
  @@map("payments")
}

model Refund {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  paymentId   String?
  payment     Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  refundNumber String
  amount      Decimal       @db.Decimal(14, 2)
  reason      String
  status      RefundStatus  @default(REQUESTED)
  requestedBy String?
  approvedBy  String?
  approvedAt  DateTime?
  rejectedBy  String?
  rejectionReason String?
  refundMethod PaymentMethod @default(CASH)
  refundedAt  DateTime?
  processedBy String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, patientId])
  @@map("refunds")
}

model Deposit {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admissionId String?
  admission   Admission?    @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  depositNumber String
  type        DepositType   @default(GENERAL)
  amount      Decimal       @db.Decimal(14, 2)
  balance     Decimal       @default(0) @db.Decimal(14, 2)
  status      DepositStatus @default(RECEIVED)
  receivedAt  DateTime      @default(now())
  receivedBy  String?
  method      PaymentMethod @default(CASH)
  referenceNumber String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  depositTransactions DepositTransaction[]

  @@index([tenantId, patientId])
  @@map("deposits")
}

model DepositTransaction {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depositId    String
  deposit      Deposit  @relation(fields: [depositId], references: [id], onDelete: Cascade)
  type         String   @default("RECEIVED") // RECEIVED, APPLIED, REFUNDED, TRANSFERRED
  amount       Decimal  @db.Decimal(14, 2)
  balanceAfter Decimal  @db.Decimal(14, 2)
  invoiceId    String?
  paymentId    String?
  notes        String?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([tenantId, depositId])
  @@map("deposit_transactions")
}

model BillingService {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String
  name         String
  category     String   @default("OTHER") // OPD, CONSULTATION, LABORATORY, RADIOLOGY, PHARMACY, PROCEDURE, OT, ICU, EMERGENCY, ROOM, BED, NURSING, AMBULANCE, MEDICAL_CERTIFICATE, OTHER
  departmentId String?
  description  String?
  price        Decimal  @default(0) @db.Decimal(14, 2)
  taxPercent   Decimal  @default(0) @db.Decimal(5, 2)
  isActive     Boolean  @default(true)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
  @@map("billing_services")
}

model FinancialTransaction {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  txnNumber     String
  type          String        // INVOICE, PAYMENT, DEPOSIT, REFUND, DISCOUNT, CREDIT, INSURANCE, ADJUSTMENT
  direction     String        // DEBIT, CREDIT
  amount        Decimal       @db.Decimal(14, 2)
  patientId     String?
  invoiceId     String?
  referenceType String?
  referenceId   String?
  method        PaymentMethod?
  status        String        @default("COMPLETED")
  notes         String?
  createdBy     String?
  createdAt     DateTime      @default(now())

  @@unique([tenantId, txnNumber])
  @@index([tenantId, createdAt])
  @@index([tenantId, patientId])
  @@map("financial_transactions")
}

model BillingSetting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     Json?
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@map("billing_settings")
  createdAt    DateTime     @default(now())
}

model DailyClosing {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  closeDate       DateTime @db.Date
  totalSales      Decimal  @default(0) @db.Decimal(14, 2)
  totalCollections Decimal @default(0) @db.Decimal(14, 2)
  cashCollected   Decimal  @default(0) @db.Decimal(14, 2)
  cardCollected   Decimal  @default(0) @db.Decimal(14, 2)
  bankCollected   Decimal  @default(0) @db.Decimal(14, 2)
  onlineCollected Decimal  @default(0) @db.Decimal(14, 2)
  refunds         Decimal  @default(0) @db.Decimal(14, 2)
  cashRefunds     Decimal  @default(0) @db.Decimal(14, 2)
  depositsReceived Decimal @default(0) @db.Decimal(14, 2)
  cashDeposits    Decimal  @default(0) @db.Decimal(14, 2)
  expectedCash    Decimal  @default(0) @db.Decimal(14, 2)
  actualCash      Decimal? @db.Decimal(14, 2)
  difference      Decimal? @db.Decimal(14, 2)
  status          String   @default("CLOSED")
  notes           String?
  closedBy        String?
  closedAt        DateTime @default(now())
  isReconciliation Boolean @default(false)

  @@unique([tenantId, closeDate])
  @@index([tenantId])
  @@map("daily_closings")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime?    @updatedAt
}

model CreditAccount {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  creditLimit  Decimal?     @db.Decimal(14, 2)
  outstanding  Decimal      @default(0) @db.Decimal(14, 2)
  status       CreditStatus @default(OPEN)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId, patientId])
  @@map("credit_accounts")
}

