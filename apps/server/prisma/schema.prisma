model EquipmentItem {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  department      String?
  model           String?
  serialNumber    String?
  manufacturer    String?
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  status          String           @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE, OUT_OF_SERVICE
  location        String?
  lastServiceDate DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  logs            EquipmentLog[]

  @@index([tenantId, status])
  @@index([tenantId, department])
  @@map("equipment_items")
}

model EquipmentLog {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipmentId  String
  equipment    EquipmentItem @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date         DateTime      @default(now())
  type         String // Preventive, Corrective, Inspection, Calibration
  notes        String?
  performedBy  String?
  createdAt    DateTime      @default(now())

  @@index([tenantId, equipmentId])
  @@map("equipment_logs")
}

