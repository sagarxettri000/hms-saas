model Membership {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
