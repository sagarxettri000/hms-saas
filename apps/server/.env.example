# Database
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/hms_saas?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# RECOMMENDED for production access tokens: RS256 asymmetric signing.
#   JWT_ACCESS_PRIVATE_KEY — PEM private key (server-side only).  When set, new
#     access tokens are signed RS256 instead of HS256.
#   JWT_ACCESS_PUBLIC_KEYS — JSON array of PEM public keys accepted for
#     verification, e.g. ["-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----"].
#     Omit to derive the public key from the private key; provide the previous
#     public key(s) too during rotation so outstanding tokens keep verifying.
#     PEM values may use literal \n escapes inside the quotes.
# JWT_ACCESS_PRIVATE_KEY=""
# JWT_ACCESS_PUBLIC_KEYS="[]"
#
# JWT_ACCESS_SECRET is the HS256 fallback / internal (2FA-setup, SSE) token
# secret.  It remains required unless RS256 keys are configured; once RS256 is
# live and all 15-minute access tokens have expired you may remove it.  The
# server refuses to boot without at least one signing credential.
JWT_ACCESS_SECRET="change-me-with-a-random-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# 2FA
TWO_FACTOR_APP_NAME="HMS SaaS"

# CORS - comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:3000"

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Row-Level Security
# REQUIRED for multi-tenant isolation: enables PostgreSQL RLS on every tenant-
# scoped table (see rls.bootstrap.ts). Super-admins and requests without a tenant
# context bypass RLS automatically. This is a production backstop to the
# application-layer tenant filtering and should be validated against a test DB
# before enabling on a live system.
ENABLE_RLS=true

# Object storage (Phase H2)
# STORAGE_DRIVER="local" # local | s3
# STORAGE_LOCAL_DIR="./storage"
# STORAGE_BUCKET="hms-saas"
# STORAGE_REGION="us-east-1"
# STORAGE_ENDPOINT=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
